    given-names: Nuno
    affiliation: "Coimbra Institute of Engineering (ISEC), Polytechnic University of Coimbra"
version: 0.1.0
license: MIT
repository-code: "https://github.com/nlavadodatasci/quasi-linear-PCA"
keywords:
  - principal components analysis
  - nonlinear PCA
  - splines
  - I-splines
  - optimal scaling
  - alternating least squares
